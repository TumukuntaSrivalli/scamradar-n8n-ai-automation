    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following OCR text for scam indicators.\n\nOCR TEXT:\n{{ $('HTTP Request').item.json.ParsedResults[0].ParsedText }}\n\nUse ONLY evidence present in the OCR text.\nDo not invent links, names, URLs, organizations, or actions.\n\nReturn ONLY valid JSON.\nDo not write anything before or after the JSON.\nDo not use markdown code blocks.\n\n{\n  \"Risk_Level\": \"High | Medium | Low | Safe\",\n  \"Scam_Type\": \"Phishing | Fake Login | OTP Scam | Payment Scam | Impersonation | Fake Job | Account Verification | Other | None\",\n  \"Confidence_Score\": 0,\n  \"Explanation\": \"Brief explanation based only on the OCR text.\",\n  \"Safety_Recommendations\": \"Clear safety advice.\"\n}\n\nConfidence_Score must be a number from 0 to 100 representing how confident the model is in its classification.",
