    {
      "parameters": {
        "jsCode": "const raw =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.content ??\n  \"\";\n\nif (!raw) {\n  throw new Error(\"No AI response was found.\");\n}\n\nconst text = String(raw).trim();\n\nlet result = {};\n\n// Try to extract JSON from the AI response\nconst start = text.indexOf(\"{\");\nconst end = text.lastIndexOf(\"}\");\n\nif (start !== -1 && end !== -1 && end > start) {\n  const jsonText = text.slice(start, end + 1);\n\n  try {\n    result = JSON.parse(jsonText);\n  } catch (error) {\n    result = {};\n  }\n}\n\n// Extract fields if AI returned normal text instead of JSON\nconst riskMatch = text.match(\n  /(?:Risk[_ ]Level|Risk Level|Risk)\\s*[:\\-]\\s*(High|Medium|Low|Safe)/i\n);\n\nconst scamMatch = text.match(\n  /(?:Scam[_ ]Type|Scam Type|Type)\\s*[:\\-]\\s*([^\\n]+)/i\n);\n\nconst confidenceMatch = text.match(\n  /(?:Confidence[_ ]Score|Confidence Score|Confidence)\\s*[:\\-]\\s*(\\d+(?:\\.\\d+)?)/i\n);\n\nconst explanationMatch = text.match(\n  /(?:Explanation|Reason)\\s*[:\\-]\\s*([^\\n]+)/i\n);\n\nconst safetyMatch = text.match(\n  /(?:Safety[_ ]Recommendations|Safety Recommendations|Safety)\\s*[:\\-]\\s*([^\\n]+)/i\n);\n\nconst riskLevel =\n  result.Risk_Level ??\n  result.risk_level ??\n  riskMatch?.[1] ??\n  \"Unknown\";\n\nconst scamType =\n  result.Scam_Type ??\n  result.scam_type ??\n  scamMatch?.[1]?.trim() ??\n  \"Unknown\";\n\nconst confidence =\n  result.Confidence_Score ??\n  result.confidence_score ??\n  confidenceMatch?.[1] ??\n  0;\n\nconst explanation =\n  result.Explanation ??\n  result.explanation ??\n  explanationMatch?.[1]?.trim() ??\n  text;\n\nconst safetyRecommendations =\n  result.Safety_Recommendations ??\n  result.safety_recommendations ??\n  safetyMatch?.[1]?.trim() ??\n  \"Verify the message through an official source before taking action.\";\n\nconst ocrText =\n  $('HTTP Request').first().json.ParsedResults?.[0]?.ParsedText ?? \"\";\n\nreturn {\n  json: {\n    risk_level: riskLevel,\n    scam_type: scamType,\n    confidence_score: Number(confidence),\n    explanation: explanation,\n    safety_recommendations: safetyRecommendations,\n    ocr_text: ocrText\n  }\n};"
      },
